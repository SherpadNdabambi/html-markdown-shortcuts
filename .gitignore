# Node.js dependencies (regenerate with `npm install`)
node_modules

# Build artifacts (compiled JS files) (regenerate with `tsc`)
out

# Lock file for Node.js dependencies (regenerate with `npm install`)
package-lock.json

# IDE files (generated by IDE)
.vscode

# VS Code test artifacts (regenerate with `npm test`)
.vscode-test/

# VS Code extension packages (regenerate with `vsce package`)
*.vsix
